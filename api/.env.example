# API configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://projectpulse:projectpulse@localhost:5432/projectpulse?schema=public
REDIS_URL=redis://localhost:6379

# Production equivalents
# NODE_ENV=production
# PORT=3001
# CORS_ORIGIN=https://pulse.pat1.online
# DATABASE_URL=<Coolify private PostgreSQL URL>
# REDIS_URL=<Coolify private Redis URL>
# GITHUB_CLIENT_ID=<production OAuth app client id>
# GITHUB_CLIENT_SECRET=<production OAuth app client secret>
# GITHUB_CALLBACK_URL=https://api.pulse.pat1.online/auth/github/callback
# WEB_URL=https://pulse.pat1.online
# AUTH_SESSION_SECRET=<secret>
# GITHUB_TOKEN_ENCRYPTION_KEY=<base64 32-byte secret>

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback
WEB_URL=http://localhost:3000
AUTH_SESSION_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Worker environment (production)
# NODE_ENV=production
# DATABASE_URL=<same ProjectPulse database>
# REDIS_URL=<same ProjectPulse Redis>
# AUTH_SESSION_SECRET=<secret>
# GITHUB_TOKEN_ENCRYPTION_KEY=<base64 32-byte secret>
# Do not add GITHUB_CLIENT_SECRET to the worker unless it is truly required.
